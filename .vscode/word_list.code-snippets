{
	// Place your German workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"A1": {
		"prefix": "aa",
		"body": [
			"- Id: ${1:word}",
			"  Level: A1",
			"  Form: ${2:¨-e}",
			"  Meaning: ${3:meaning}",
			"  Examples:",
			"    - ${4:example}",
			"$0"
		]
	},
	"A2": {
		"scope": "yaml",
		"prefix": "ab",
		"body": [
			"- Id: ${1:word}",
			"  Level: A2",
			"  Form: ${2:¨-e}",
			"  Meaning: ${3:meaning}",
			"  Examples:",
			"    - ${4:example}",
			"$0"
		]
	},
	"B1": {
		"scope": "yaml",
		"prefix": "bb",
		"body": [
			"- Id: ${1:word}",
			"  Level: B1",
			"  Form: ${2:¨-e}",
			"  Meaning: ${3:meaning}",
			"  Examples:",
			"    - ${4:example}",
			"$0"
		]
	},
	"Synonym": {
		"scope": "yaml",
		"prefix": "s",
		"body": [
			"Synonym: (CH) = (D, A) ${1:synonym}$0"
		]
	},
	"Feminine": {
		"scope": "yaml",
