                    }
                    
                })
                $("#searchBarDropDown").on("click", function(e){
                    var queryWord = $("#searchInput").val();
                    if(queryWord.trim() !== ""){
                        $("#english-chinese-link").attr("href", `/words/search-english-chinese?word=${queryWord}`)
