                        $("#english-lecture-link").attr("href", `/courses/search-lecture?keyword=${queryWord}&language=English`)
                        $("#german-lecture-link").attr("href", `/courses/search-lecture?keyword=${queryWord}&language=German`)
                        $("#arabic-lecture-link").attr("href", `/courses/search-lecture?keyword=${queryWord}&language=Arabic`)
                        $("#french-lecture-link").attr("href", `/courses/search-lecture?keyword=${queryWord}&language=French`)
                        $("#spanish-lecture-link").attr("href", `/courses/search-lecture?keyword=${queryWord}&language=Spanish`)
